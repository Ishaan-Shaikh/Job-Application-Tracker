    {
      "name": "Error handling and validation",
      "item": [
        {
          "name": "Create job - missing title and company -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "const res = pm.response.json();",
                  "pm.test('Error says validation failed', () => pm.expect(res.error).to.eql('Validation failed'));",
                  "pm.test('Details list title and company', () => {",
                  "  const fields = res.details.map(d => d.field);",
                  "  pm.expect(fields).to.include.members(['title', 'company']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
