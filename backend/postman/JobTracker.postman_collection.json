{
  "info": {
    "name": "Job Tracker API",
    "description": "REST API for the Job Application Tracker (Node.js + Express). Run the requests in order: the \"Create\" request saves {{jobId}} for the ones after it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CRUD operations",
      "item": [
        {
          "name": "1. Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('API reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "2. Create job (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
                  "const job = pm.response.json();",
                  "pm.test('Response contains an id and the data that was sent', () => {",
                  "  pm.expect(job).to.have.property('id');",
                  "  pm.expect(job.title).to.eql('Full Stack Developer');",
                  "  pm.expect(job.company).to.eql('TechNova');",
                  "});",
                  "pm.test('Location header points to the new job', () => pm.expect(pm.response.headers.get('Location')).to.include(job.id));",
                  "// save the new id so the next requests can use {{jobId}}",
                  "pm.collectionVariables.set('jobId', job.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Full Stack Developer\",\n  \"company\": \"TechNova\",\n  \"status\": \"applied\",\n  \"location\": \"Pune\",\n  \"date\": \"2025-10-01\",\n  \"notes\": \"Applied via careers page.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "3. Get all jobs (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const jobs = pm.response.json();",
                  "pm.test('Response is an array', () => pm.expect(jobs).to.be.an('array'));",
                  "pm.test('List contains the job we created', () => {",
                  "  pm.expect(jobs.some(j => j.id === pm.collectionVariables.get('jobId'))).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs"
              ]
            }
          }
        },
        {
          "name": "4. Filter jobs by status (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Every returned job has status \"applied\"', () => {",
                  "  pm.response.json().forEach(j => pm.expect(j.status).to.eql('applied'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs?status=applied",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "applied"
                }
              ]
            }
          }
        },
        {
          "name": "5. Get one job by id (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returned job has the requested id', () => {",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('jobId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}"
              ]
            }
          }
        },
        {
          "name": "6. Update job (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const job = pm.response.json();",
                  "pm.test('Status was updated to interview', () => pm.expect(job.status).to.eql('interview'));",
                  "pm.test('Id did not change', () => pm.expect(job.id).to.eql(pm.collectionVariables.get('jobId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Full Stack Developer\",\n  \"company\": \"TechNova\",\n  \"status\": \"interview\",\n  \"location\": \"Remote\",\n  \"date\": \"2025-10-01\",\n  \"notes\": \"Interview scheduled.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "7. Delete job (DELETE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}"
              ]
            }
          }
        },
        {
          "name": "8. Get deleted job -> 404 (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('Error message is returned', () => pm.expect(pm.response.json().error).to.include('not found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}"
              ]
            }
          }
        }
      ]
